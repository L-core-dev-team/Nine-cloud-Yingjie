{"id":"空封","split":"held","family":"delivery","style":"后果回照、物证、人物视角","rows":[{"text":"柱角还压着去年的催件。","asOf":1,"visual":false},{"text":"简秋答应把原札交给档房。","setup":true,"asOf":2,"visual":false},{"text":"看门人烧掉废封。","asOf":3,"visual":false},{"text":"档房开门时只捡到写着简秋名字的空封。","claim":{"kind":"delivery","actor":"简秋","other":"档房","item":"原札","before":"promised","after":"delivered","polarity":"positive","source":"narrator","time":"current","qualifier":"unconditional"},"verdict":"unresolved","review":true,"event":false,"deps":[2],"why":"档房开门时只捡到写着简秋名字的空封。","asOf":4,"visual":false,"span":[0,18]},{"text":"柱角还压着去年的催件。","asOf":5,"visual":false},{"text":"「要是明天有个准信就好了。」","asOf":6,"visual":false},{"text":"等消息的人起身，又坐回原处。","asOf":7,"visual":false},{"text":"简秋将原札交给档房。档房当场签收了原札。","claim":{"kind":"delivery","actor":"简秋","other":"档房","item":"原札","before":"promised","after":"delivered","polarity":"positive","source":"narrator","time":"current","qualifier":"unconditional"},"verdict":"supported","review":true,"event":true,"deps":[2],"why":"简秋将原札交给档房。档房当场签收了原札。","asOf":8,"visual":false,"span":[0,20]},{"text":"地砖缝里生了青苔。","asOf":9,"visual":false},{"text":"换班的人合上了窗。","asOf":10,"visual":false}],"rank":[8]}
{"id":"借碗","split":"held","family":"delivery","style":"后果回照、物证、人物视角","rows":[{"text":"粥棚缺一把铜勺，包映当着施粥所管事点头应下。","setup":true,"asOf":1,"visual":false},{"text":"米袋渐空。","asOf":2,"visual":false},{"text":"有人说铜勺已到，施粥所还在用木瓢。","claim":{"kind":"delivery","actor":"包映","other":"施粥所","item":"铜勺","before":"promised","after":"delivered","polarity":"positive","source":"narrator","time":"current","qualifier":"unconditional"},"verdict":"unresolved","review":true,"event":false,"deps":[1],"why":"有人说铜勺已到，施粥所还在用木瓢。","asOf":3,"visual":false,"span":[0,17]},{"text":"锅沿碰得发白。","asOf":4,"visual":false},{"text":"等消息的人起身，又坐回原处。","asOf":5,"visual":false},{"text":"夜里下了一阵雨。","asOf":6,"visual":false},{"text":"第二天，廊边多了几道浅浅的水痕。","asOf":7,"visual":false},{"text":"到了月底，谁也没有再来敲那扇门。","asOf":8,"visual":false},{"text":"包映把铜勺放进滚开的锅里，施粥所的管事拿它舀满第一碗。","claim":{"kind":"delivery","actor":"包映","other":"施粥所","item":"铜勺","before":"promised","after":"delivered","polarity":"positive","source":"narrator","time":"current","qualifier":"unconditional"},"verdict":"supported","review":true,"event":true,"deps":[1],"why":"包映把铜勺放进滚开的锅里，施粥所的管事拿它舀满第一碗。","asOf":9,"visual":false,"span":[0,27]},{"text":"一只碗缺了个小角。","asOf":10,"visual":false},{"text":"入冬以后，人们还记得那一天。","asOf":11,"visual":false}],"rank":[9]}
